IMMORTAL_PUBLIC_REGTEST_GATEWAY_STATE_DIR=/var/lib/immortal-public-regtest/gateway
IMMORTAL_PUBLIC_REGTEST_GATEWAY_BIND=127.0.0.1:19337
IMMORTAL_PUBLIC_REGTEST_ORIGIN=https://bazaar.regtest.example.com
IMMORTAL_PUBLIC_REGTEST_SIGNING_KEY_FILE=/etc/immortal-public-regtest/gateway-signing-key
IMMORTAL_PUBLIC_REGTEST_SOURCE_REVISION=REPLACE_WITH_40_LOWER_HEX_REVISION
IMMORTAL_PUBLIC_REGTEST_REQUESTER_CONTRACT_DIGEST=REPLACE_WITH_64_LOWER_HEX_DIGEST
IMMORTAL_PUBLIC_REGTEST_PROVIDER_SET=REPLACE_WITH_SORTED_COMMA_SEPARATED_PROVIDER_PUBKEYS
IMMORTAL_PUBLIC_REGTEST_SESSION_LIFETIME_SECONDS=900
IMMORTAL_PUBLIC_REGTEST_EFFECT_TIMEOUT_SECONDS=180
