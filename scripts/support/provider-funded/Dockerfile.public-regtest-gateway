FROM rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55 AS build

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY migrations ./migrations
COPY crates ./crates
COPY nips ./nips
COPY tests ./tests
RUN cargo build --locked --release \
    -p immortal-public-regtest-gateway --bin immortal-public-regtest-gateway

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

RUN useradd --uid 10001 --user-group --no-create-home \
    --home-dir /nonexistent --shell /usr/sbin/nologin immortal
COPY --from=build /build/target/release/immortal-public-regtest-gateway \
    /usr/local/bin/immortal-public-regtest-gateway
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/immortal-public-regtest-gateway"]
