+#[instrument(name = "cmd::immortal_regtest_invoice", skip_all)]
+pub async fn immortal_regtest_invoice<T, E>(
+    plugin: Plugin<State<T, E>>,
+    args: Value,
+) -> Result<Value>
+where
+    T: InvoiceHelper + Sync + Send + Clone,
+    E: InvoiceEncoder + Sync + Send + Clone,
+{
+    if plugin.configuration().network != "regtest" {
+        return Err(anyhow::anyhow!(
+            "immortal regtest invoice method requires regtest"
+        ));
+    }
+    let params = parse_args::<ImmortalRegtestInvoiceRequest>(args)?;
+    if params.expiry_seconds != 30 || params.min_final_cltv_expiry_delta != 80 {
+        return Err(anyhow::anyhow!(
+            "immortal regtest invoice policy is not exact"
+        ));
+    }
+    let minimum_final_cltv_expiry_delta =
+        i32::try_from(params.min_final_cltv_expiry_delta)?;
+    let payment_hash = hex::decode(params.payment_hash)?;
+    let invoice = plugin
+        .state()
+        .encoder
+        .encode(
+            InvoiceBuilder::new(&payment_hash)
+                .amount_msat(params.amount)
+                .expiry(params.expiry_seconds)
+                .min_final_cltv_expiry_delta(params.min_final_cltv_expiry_delta),
+        )
+        .await?;
+    plugin.state().invoice_helper.insert(&InvoiceInsertable {
+        invoice: invoice.clone(),
+        payment_hash: payment_hash.clone(),
+        state: InvoiceState::Unpaid.into(),
+        min_cltv: Some(minimum_final_cltv_expiry_delta),
+    })?;
+    plugin
+        .state()
+        .settler
+        .new_invoice(invoice.clone(), payment_hash, params.amount);
+
+    Ok(serde_json::to_value(&InvoiceResponse { bolt11: invoice })?)
+}
