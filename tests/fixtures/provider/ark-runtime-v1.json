{
  "schema": "openagents.immortal.provider-ark-runtime.v1",
  "source": {
    "profile": "mkt-swp",
    "profile_version": 1,
    "upstream_commit": "c241e324e4a195c6a1fcbb04acc54647c2fa2208"
  },
  "reserve_unit": {
    "format": "ark:<protocol_family>:<operator_identity_sha256>:<vtxo_txid>:<vout>",
    "protocol_families": ["arkade", "bark"],
    "blocking_states": ["active", "unresolved"],
    "release_state": "released"
  },
  "reservation_cases": [
    {
      "name": "ark-reserve-v1-first-writer",
      "expected": "reserved"
    },
    {
      "name": "ark-reserve-v1-exact-replay",
      "expected": "replay"
    },
    {
      "name": "ark-reserve-v1-other-bucket-double-use",
      "expected": "reserve_unit_unavailable"
    },
    {
      "name": "ark-reserve-v1-operator-alias-double-use",
      "expected": "reserve_unit_unavailable"
    },
    {
      "name": "ark-reserve-v1-changed-proof",
      "expected": "conflict"
    },
    {
      "name": "ark-reserve-v1-release-then-reuse",
      "expected": "reserved"
    },
    {
      "name": "ark-reserve-v1-unresolved-blocks-reuse",
      "expected": "reserve_unit_unavailable"
    }
  ],
  "transfer_effect": {
    "command_schema": "openagents.immortal.ark-transfer-command.v1",
    "operation": "ark_transfer",
    "participant_input": "verified_ark_client_snapshot_and_externally_signed_transaction",
    "persist_before_operator_rpc": true,
    "restart_probe": "observe_exact_output_vtxo_before_exact_submit_replay",
    "result_binding": [
      "operator_identity_sha256",
      "input_vtxo_ids",
      "output_vtxo_id",
      "signed_vtxo_graph_sha256",
      "exit_package_sha256",
      "ark_transaction_id"
    ],
    "retained_request": [
      "order_id",
      "effect_id",
      "operator_identity_sha256",
      "input_vtxo_ids",
      "output_vtxo_id",
      "signed_ark_transaction_sha256",
      "final_ark_transaction_sha256",
      "checkpoint_transaction_sha256",
      "final_checkpoint_transaction_sha256",
      "signed_vtxo_graph_sha256",
      "exit_package_sha256"
    ],
    "never_retained": [
      "raw_signed_transaction",
      "raw_checkpoint_transaction",
      "raw_exit_package",
      "client_snapshot",
      "artifact_ref"
    ],
    "cases": [
      {"name": "ark-transfer-v1-first-apply", "expected": "applied"},
      {"name": "ark-transfer-v1-exact-replay", "expected": "replay_without_rpc"},
      {"name": "ark-transfer-v1-crash-observation", "expected": "recovered_from_exact_vtxo"},
      {"name": "ark-transfer-v1-changed-graph", "expected": "conflict"},
      {"name": "ark-transfer-v1-changed-exit", "expected": "conflict"},
      {"name": "ark-transfer-v1-operator-result-change", "expected": "fail_closed"}
    ],
    "mkt_pair_advertisement": false,
    "native_session_actor": false
  },
  "custody_rejected": [
    "seed",
    "preimage",
    "macaroon",
    "claim_key",
    "refund_key",
    "fee_key",
    "spend_key",
    "vtxo_key",
    "private_nonce",
    "operator_token"
  ]
}
