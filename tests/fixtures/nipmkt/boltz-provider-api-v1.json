  "process_gate": {
    "listener_bind": "runtime private IPv4 address of the provider and Bitcoin shared network namespace",
    "host_publication": "random host loopback port mapped to the shared namespace port 19093",
    "readiness_route": "GET /v2/version",
    "clean_room_client_seams": ["go", "web"],
    "pinned_upstream_client_builds": false,
    "route_inventory_source": "pinned upstream source and Git blob inspection",
    "dependent_call_union": 19,
    "fresh_session_per_seam": true,
    "submarine_process_order": [
      "signed_rfq_quote_order",
      "prepare_raw_funding_without_broadcast",
      "rust_client_engine_contract_exchange_and_exit_persistence",
      "restore_funding_authorization_snapshot",
      "compare_provider_finalize_with_local_approval",
      "broadcast_exact_prepared_bytes",
      "complete_native_session"
    ],
    "control_file_law": "atomic rename of mode-0600 files in a mode-0700 disposable directory",
    "contract_ids_are_callback_outputs": true,
    "authorization_receipt": "sha256 of the client snapshot restored through resume_funding_authorized before local approval",
    "first_http_broadcast_evidence": "each fresh clean-room seam broadcasts its prepared transaction only after the Rust client-engine callback approves it",
    "absence_before_broadcast_evidence": "bitcoind public lookup fails before each seam receives local approval",
    "exact_replay_evidence": "both clean-room seams resubmit their exact prepared bytes after the first broadcast",
    "same_txid_witness_conflict_evidence": "the Go and web processes mutate witness bytes, prove the txid is unchanged, and require refusal",
    "heartbeat_evidence": "the selected fresh Go process keeps one provider WebSocket open for more than 31 seconds, receives the pinned web application JSON pong and Go control pong, then receives a subscribed status update",
    "reverse_claim_evidence": "both adapted clients resubmit the public script-path claim",
    "unbound_broadcast_evidence": "both adapted clients submit another session's funding bytes and require refusal",
    "intermediate_status_evidence": "in-process dense signer projection corpus",
    "scope_limit": "the clean-room seams prove the extracted funding boundary and pinned route shapes; this repository does not build or patch the pinned upstream Go daemon or web application"
  },
