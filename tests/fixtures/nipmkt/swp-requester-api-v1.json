{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "openagents.mkt-swp.requester-api-fixture.v1",
  "view_schema": "openagents.mkt-swp.requester-session-view.v1",
  "operations": [
    {
      "name": "requester_order",
      "input_schema": {"$ref": "#/$defs/requester_order_input"},
      "output_schema": {"$ref": "#/$defs/signing_request"}
    },
    {
      "name": "requester_contract_draft",
      "input_schema": {"$ref": "#/$defs/requester_contract_draft_input"},
      "output_schema": {"$ref": "#/$defs/swp_contract"}
    },
    {
      "name": "requester_contract",
      "input_schema": {"$ref": "#/$defs/requester_contract_signing_input"},
      "output_schema": {"$ref": "#/$defs/signing_request"}
    },
    {
      "name": "requester_session_view",
      "input_schema": {"$ref": "#/$defs/requester_session_input"},
      "output_schema": {"$ref": "#/$defs/requester_session_view"}
    },
    {
      "name": "requester_session_view_with_effects",
      "input_schema": {"$ref": "#/$defs/requester_session_with_effects_input"},
      "output_schema": {"$ref": "#/$defs/requester_session_view"}
    }
  ],
  "$defs": {
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "nullable_decimal": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "tag": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 2048}
    },
    "nostr_event": {
      "type": "object",
      "required": ["id", "pubkey", "created_at", "kind", "tags", "content", "sig"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "integer", "minimum": 0},
        "kind": {"type": "integer", "minimum": 0, "maximum": 65535},
        "tags": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/tag"}},
        "content": {"type": "string"},
        "sig": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      },
      "additionalProperties": false
    },
    "signing_request": {
      "type": "object",
      "required": ["pubkey", "created_at", "kind", "tags", "content", "expected_event_id"],
      "properties": {
        "pubkey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "integer", "minimum": 0},
        "kind": {"type": "integer", "minimum": 39604, "maximum": 39610},
        "tags": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/tag"}},
        "content": {"type": "string"},
        "expected_event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "requester_contract_inputs": {
      "type": "object",
      "required": ["effect_bindings", "exit_package_commitments"],
      "properties": {
        "effect_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/effect_binding"}
        },
        "exit_package_commitments": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/exit_package_commitment"}
        }
      },
      "additionalProperties": false
    },
    "requester_order_input": {
      "type": "object",
      "required": ["rfq", "quote", "created_at", "observed_at", "distinct", "selection"],
      "properties": {
        "rfq": {"$ref": "#/$defs/nostr_event"},
        "quote": {"$ref": "#/$defs/nostr_event"},
        "created_at": {"type": "integer", "minimum": 0},
        "observed_at": {"type": "integer", "minimum": 0},
        "distinct": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selection": {
          "anyOf": [
            {"$ref": "#/$defs/order_selection"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "order_selection": {
      "type": "object",
      "properties": {
        "input_amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "fee_payer": {"type": "string"},
        "confirmation_policy": {"$ref": "#/$defs/selection_confirmation_policy"},
        "public_receipt_consent": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "selection_confirmation_policy": {
      "type": "object",
      "properties": {
        "minimum_confirmations": {"$ref": "#/$defs/decimal"},
        "reorg_safety_blocks": {"$ref": "#/$defs/decimal"},
        "zero_confirmation": {"enum": ["forbidden", "allowed"]},
        "rbf": {"enum": ["reject", "track"]},
        "replacement": {"enum": ["reject", "track"]}
      },
      "additionalProperties": false
    },
    "requester_contract_draft_input": {
      "type": "object",
      "required": ["rfq", "quote", "order", "order_observed_at", "local_inputs"],
      "properties": {
        "rfq": {"$ref": "#/$defs/nostr_event"},
        "quote": {"$ref": "#/$defs/nostr_event"},
        "order": {"$ref": "#/$defs/nostr_event"},
        "order_observed_at": {"type": "integer", "minimum": 0},
        "local_inputs": {"$ref": "#/$defs/requester_contract_inputs"}
      },
      "additionalProperties": false
    },
    "requester_contract_signing_input": {
      "type": "object",
      "required": ["rfq", "quote", "order", "order_observed_at", "created_at", "distinct", "contract"],
      "properties": {
        "rfq": {"$ref": "#/$defs/nostr_event"},
        "quote": {"$ref": "#/$defs/nostr_event"},
        "order": {"$ref": "#/$defs/nostr_event"},
        "order_observed_at": {"type": "integer", "minimum": 0},
        "created_at": {"type": "integer", "minimum": 0},
        "distinct": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract": {"$ref": "#/$defs/swp_contract"}
      },
      "additionalProperties": false
    },
    "price_feed_pin": {
      "type": "object",
      "required": ["url", "value_pointer", "observed_value", "response_sha256", "observed_at", "max_age_seconds"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "value_pointer": {"type": "string", "maxLength": 512},
        "observed_value": {"$ref": "#/$defs/decimal"},
        "response_sha256": {"$ref": "#/$defs/hex32"},
        "observed_at": {"type": "integer", "minimum": 0},
        "max_age_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "effect_binding": {
      "type": "object",
      "required": ["role", "leg_id"],
      "properties": {
        "role": {"enum": ["chain_fund", "chain_claim", "chain_refund", "invoice_pay"]},
        "leg_id": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "exit_package_commitment": {
      "type": "object",
      "required": ["participant_role", "leg_id", "path", "package_mode", "package_sha256"],
      "properties": {
        "participant_role": {"const": "requester"},
        "leg_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "path": {"enum": ["claim", "refund"]},
        "package_mode": {"enum": ["presigned", "wallet_sign"]},
        "package_sha256": {"$ref": "#/$defs/hex32"}
      },
      "additionalProperties": false
    },
    "evidence_authority": {
      "type": "object",
      "required": ["adapter_sha256", "mode", "pubkeys"],
      "properties": {
        "adapter_sha256": {"$ref": "#/$defs/hex32"},
        "mode": {"const": "local"},
        "pubkeys": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/hex32"}}
      },
      "additionalProperties": false
    },
    "bitcoin_leg": {
      "type": "object",
      "required": ["amount", "asset_id", "claim_public_key", "confirmation_policy", "funding_role", "leg_id", "network_id", "payment_hash", "rail", "receiving_role", "refund_condition", "refund_lock_value", "refund_public_key", "script_pubkey", "verifier_digest", "verifier_policy"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "asset_id": {"type": "string", "pattern": "^swp:1:"},
        "claim_public_key": {"$ref": "#/$defs/hex32"},
        "confirmation_policy": {"$ref": "#/$defs/bitcoin_leg_confirmation"},
        "funding_role": {"enum": ["requester", "provider"]},
        "leg_id": {"enum": ["source", "destination"]},
        "network_id": {"type": "string", "pattern": "^bip122:[0-9a-f]{32}$"},
        "payment_hash": {"$ref": "#/$defs/hex32"},
        "rail": {"const": "bitcoin"},
        "receiving_role": {"enum": ["requester", "provider"]},
        "refund_condition": {"enum": ["cltv", "csv"]},
        "refund_lock_value": {"$ref": "#/$defs/decimal"},
        "refund_public_key": {"$ref": "#/$defs/hex32"},
        "script_pubkey": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "verifier_digest": {"$ref": "#/$defs/hex32"},
        "verifier_policy": {"const": "mkt-swp-bitcoin-v1"}
      },
      "additionalProperties": false
    },
    "bitcoin_leg_confirmation": {
      "type": "object",
      "required": ["minimum_confirmations", "replacement_policy"],
      "properties": {
        "minimum_confirmations": {"$ref": "#/$defs/decimal"},
        "replacement_policy": {"enum": ["reject", "track"]}
      },
      "additionalProperties": false
    },
    "lightning_leg": {
      "type": "object",
      "required": ["amount", "asset_id", "funding_role", "invoice_expiry_seconds", "invoice_minimum_final_cltv_delta", "invoice_sha256", "leg_id", "network_id", "payment_hash", "rail", "receiving_role", "verifier_digest", "verifier_policy"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "asset_id": {"type": "string", "pattern": "^swp:1:"},
        "funding_role": {"enum": ["requester", "provider"]},
        "invoice_expiry_seconds": {"$ref": "#/$defs/decimal"},
        "invoice_minimum_final_cltv_delta": {"$ref": "#/$defs/decimal"},
        "invoice_sha256": {"$ref": "#/$defs/hex32"},
        "leg_id": {"const": "lightning"},
        "network_id": {"type": "string", "pattern": "^bip122:[0-9a-f]{32}$"},
        "payment_hash": {"$ref": "#/$defs/hex32"},
        "rail": {"const": "lightning"},
        "receiving_role": {"enum": ["requester", "provider"]},
        "verifier_digest": {"$ref": "#/$defs/hex32"},
        "verifier_policy": {"const": "mkt-swp-lightning-v1"}
      },
      "additionalProperties": false
    },
    "taproot_path": {
      "type": "object",
      "required": ["condition", "lock_value", "participant_role", "path", "script", "signing_pubkey"],
      "properties": {
        "condition": {"enum": ["hashlock", "cltv", "csv"]},
        "lock_value": {"$ref": "#/$defs/nullable_decimal"},
        "participant_role": {"enum": ["requester", "provider"]},
        "path": {"enum": ["claim", "refund"]},
        "script": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "signing_pubkey": {"$ref": "#/$defs/hex32"}
      },
      "additionalProperties": false
    },
    "cooperative_pubkey": {
      "type": "object",
      "required": ["participant_role", "public_key"],
      "properties": {
        "participant_role": {"enum": ["requester", "provider"]},
        "public_key": {"type": "string", "pattern": "^(02|03)[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "bitcoin_verifier_input": {
      "type": "object",
      "required": ["amount", "cooperative_internal_key", "cooperative_pubkeys", "evidence_authority", "exit_condition", "exit_lock_value", "exit_path", "exit_signing_pubkey", "funding_transaction", "funding_transaction_sha256", "leg_id", "minimum_confirmations", "output_index", "rbf_policy", "reorg_safety_blocks", "replacement_policy", "script_pubkey", "swap_tree_sha256", "taproot_control_block", "taproot_merkle_root", "taproot_output_key", "taproot_script", "taproot_tree", "verifier_policy", "zero_confirmation"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "cooperative_internal_key": {"$ref": "#/$defs/hex32"},
        "cooperative_pubkeys": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/cooperative_pubkey"}},
        "evidence_authority": {"$ref": "#/$defs/evidence_authority"},
        "exit_condition": {"enum": ["hashlock", "cltv", "csv"]},
        "exit_lock_value": {"$ref": "#/$defs/nullable_decimal"},
        "exit_path": {"enum": ["claim", "refund"]},
        "exit_signing_pubkey": {"$ref": "#/$defs/hex32"},
        "funding_transaction": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "funding_transaction_sha256": {"$ref": "#/$defs/hex32"},
        "leg_id": {"enum": ["source", "destination"]},
        "minimum_confirmations": {"$ref": "#/$defs/decimal"},
        "output_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "rbf_policy": {"enum": ["reject", "track"]},
        "reorg_safety_blocks": {"$ref": "#/$defs/decimal"},
        "replacement_policy": {"enum": ["reject", "track"]},
        "script_pubkey": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "swap_tree_sha256": {"$ref": "#/$defs/hex32"},
        "taproot_control_block": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "taproot_merkle_root": {"$ref": "#/$defs/hex32"},
        "taproot_output_key": {"$ref": "#/$defs/hex32"},
        "taproot_script": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "taproot_tree": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/taproot_path"}},
        "verifier_policy": {"const": "mkt-swp-bitcoin-v1"},
        "zero_confirmation": {"enum": ["forbidden", "allowed"]}
      },
      "additionalProperties": false
    },
    "lightning_verifier_input": {
      "type": "object",
      "required": ["evidence_authority", "invoice_amount_msat", "invoice_expiry_seconds", "invoice_minimum_final_cltv_delta", "invoice_network", "invoice_sha256", "leg_id", "verifier_policy"],
      "properties": {
        "evidence_authority": {"$ref": "#/$defs/evidence_authority"},
        "invoice_amount_msat": {"$ref": "#/$defs/decimal"},
        "invoice_expiry_seconds": {"$ref": "#/$defs/decimal"},
        "invoice_minimum_final_cltv_delta": {"$ref": "#/$defs/decimal"},
        "invoice_network": {"enum": ["bitcoin", "testnet", "signet", "regtest"]},
        "invoice_sha256": {"$ref": "#/$defs/hex32"},
        "leg_id": {"const": "lightning"},
        "verifier_policy": {"const": "mkt-swp-lightning-v1"}
      },
      "additionalProperties": false
    },
    "reservation_commitment": {
      "type": "object",
      "required": ["allocation_sequence", "capacity_bucket_id", "capacity_commitment_sha256", "covenant_commitment", "handler_committed_capacity", "profile_timeout_at", "proof_class", "proof_ref_sha256", "proof_strength", "quote_id", "reservation_class", "reservation_expires_at", "reservation_id", "reserved_amount", "reserved_asset_id", "rfq_id", "session_id"],
      "properties": {
        "allocation_sequence": {"$ref": "#/$defs/decimal"},
        "capacity_bucket_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "capacity_commitment_sha256": {"$ref": "#/$defs/hex32"},
        "covenant_commitment": {"anyOf": [{"$ref": "#/$defs/covenant_commitment"}, {"type": "null"}]},
        "handler_committed_capacity": {"$ref": "#/$defs/decimal"},
        "profile_timeout_at": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "proof_class": {"enum": ["provider_signed", "handler_accounted", "third_party_guarantee", "lightning_liquidity", "utxo_control", "funded_htlc", "covenant_reserve"]},
        "proof_ref_sha256": {"$ref": "#/$defs/hex32"},
        "proof_strength": {"type": "integer", "minimum": 0, "maximum": 65535},
        "quote_id": {"$ref": "#/$defs/hex32"},
        "reservation_class": {"enum": ["soft", "hard"]},
        "reservation_expires_at": {"type": "integer", "minimum": 0},
        "reservation_id": {"$ref": "#/$defs/hex32"},
        "reserved_amount": {"$ref": "#/$defs/decimal"},
        "reserved_asset_id": {"type": "string", "pattern": "^swp:1:"},
        "rfq_id": {"$ref": "#/$defs/hex32"},
        "session_id": {"$ref": "#/$defs/hex32"}
      },
      "additionalProperties": false
    },
    "covenant_commitment": {
      "type": "object",
      "required": ["reserve_unit_sha256", "program_sha256", "eligible_fill_sha256", "fee_rule_sha256", "verifier_view_sha256", "minimum_output", "expires_at"],
      "properties": {
        "reserve_unit_sha256": {"$ref": "#/$defs/hex32"},
        "program_sha256": {"$ref": "#/$defs/hex32"},
        "eligible_fill_sha256": {"$ref": "#/$defs/hex32"},
        "fee_rule_sha256": {"$ref": "#/$defs/hex32"},
        "verifier_view_sha256": {"$ref": "#/$defs/hex32"},
        "minimum_output": {"$ref": "#/$defs/decimal"},
        "expires_at": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "timeout_ladder": {
      "oneOf": [
        {
          "type": "object",
          "required": ["swap_type", "current_height", "fund_last", "claim_last", "refund_first", "claim_expected_time", "invoice_expiration_time", "broadcast_safety_blocks", "reorg_safety_blocks", "chain_finality_blocks"],
          "properties": {
            "swap_type": {"const": "submarine"}, "current_height": {"type": "integer", "minimum": 0}, "fund_last": {"type": "integer", "minimum": 0}, "claim_last": {"type": "integer", "minimum": 0}, "refund_first": {"type": "integer", "minimum": 0}, "claim_expected_time": {"type": "integer", "minimum": 0}, "invoice_expiration_time": {"type": "integer", "minimum": 0}, "broadcast_safety_blocks": {"type": "integer", "minimum": 1}, "reorg_safety_blocks": {"type": "integer", "minimum": 1}, "chain_finality_blocks": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["swap_type", "current_height", "lock_last", "user_claim_last", "provider_refund_first", "hold_expiry_height", "provider_claim_margin", "lightning_settlement_blocks", "broadcast_safety_blocks", "reorg_safety_blocks", "chain_finality_blocks"],
          "properties": {
            "swap_type": {"const": "reverse"}, "current_height": {"type": "integer", "minimum": 0}, "lock_last": {"type": "integer", "minimum": 0}, "user_claim_last": {"type": "integer", "minimum": 0}, "provider_refund_first": {"type": "integer", "minimum": 0}, "hold_expiry_height": {"type": "integer", "minimum": 0}, "provider_claim_margin": {"type": "integer", "minimum": 1}, "lightning_settlement_blocks": {"type": "integer", "minimum": 1}, "broadcast_safety_blocks": {"type": "integer", "minimum": 1}, "reorg_safety_blocks": {"type": "integer", "minimum": 1}, "chain_finality_blocks": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["swap_type", "current_height", "destination_final", "source_refund_time", "destination_refund_time", "both_network_broadcast_margins", "both_network_reorg_margins", "broadcast_safety_blocks", "reorg_safety_blocks", "chain_finality_blocks"],
          "properties": {
            "swap_type": {"const": "chain"}, "current_height": {"type": "integer", "minimum": 0}, "destination_final": {"type": "integer", "minimum": 0}, "source_refund_time": {"type": "integer", "minimum": 0}, "destination_refund_time": {"type": "integer", "minimum": 0}, "both_network_broadcast_margins": {"type": "integer", "minimum": 1}, "both_network_reorg_margins": {"type": "integer", "minimum": 1}, "broadcast_safety_blocks": {"type": "integer", "minimum": 1}, "reorg_safety_blocks": {"type": "integer", "minimum": 1}, "chain_finality_blocks": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "swp_contract": {
      "type": "object",
      "required": ["amount_equation", "asset_pair", "cancellation", "clock_skew_seconds", "confirmation_policy", "desired_completion_time", "effect_bindings", "evidence_requirements", "evm_leg", "exit_package_commitments", "fee_bps", "fee_payer", "input_amount", "legs", "lightning_routing_fee_budget", "maximum_total_fee", "miner_fee_budget", "order_id", "output_amount", "payment_hash", "price_feed", "provider_fee", "quote_id", "recovery", "reservation_commitment", "rounding", "script_mode", "swap_type", "timeout_ladder", "verifier_inputs"],
      "properties": {
        "amount_equation": {"const": "input_minus_provider_and_quoted_fees"},
        "asset_pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^swp:1:"}},
        "cancellation": {"$ref": "#/$defs/cancellation_policy"},
        "clock_skew_seconds": {"$ref": "#/$defs/decimal"},
        "confirmation_policy": {"$ref": "#/$defs/confirmation_policy"},
        "desired_completion_time": {"type": "integer", "minimum": 1},
        "effect_bindings": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/effect_binding"}},
        "evidence_requirements": {"$ref": "#/$defs/evidence_requirements"},
        "evm_leg": {"type": "null"},
        "exit_package_commitments": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/exit_package_commitment"}},
        "fee_bps": {"$ref": "#/$defs/decimal"},
        "fee_payer": {"enum": ["requester", "provider"]},
        "input_amount": {"$ref": "#/$defs/decimal"},
        "legs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"oneOf": [{"$ref": "#/$defs/bitcoin_leg"}, {"$ref": "#/$defs/lightning_leg"}]}},
        "lightning_routing_fee_budget": {"$ref": "#/$defs/decimal"},
        "maximum_total_fee": {"$ref": "#/$defs/decimal"},
        "miner_fee_budget": {"$ref": "#/$defs/decimal"},
        "order_id": {"$ref": "#/$defs/hex32"},
        "order_selection": {"$ref": "#/$defs/order_selection"},
        "output_amount": {"$ref": "#/$defs/decimal"},
        "payment_hash": {"$ref": "#/$defs/hex32"},
        "price_feed": {"anyOf": [{"$ref": "#/$defs/price_feed_pin"}, {"type": "null"}]},
        "provider_fee": {"$ref": "#/$defs/decimal"},
        "public_receipt_consent": {"type": "boolean"},
        "quote_id": {"$ref": "#/$defs/hex32"},
        "recovery": {"$ref": "#/$defs/recovery_policy"},
        "reservation_commitment": {"$ref": "#/$defs/reservation_commitment"},
        "rounding": {"const": "floor_output_sats"},
        "script_mode": {"const": "taproot-musig2-script-exit"},
        "swap_type": {"enum": ["submarine", "reverse", "chain"]},
        "timeout_ladder": {"$ref": "#/$defs/timeout_ladder"},
        "verifier_inputs": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"oneOf": [{"$ref": "#/$defs/bitcoin_verifier_input"}, {"$ref": "#/$defs/lightning_verifier_input"}]}}
      },
      "additionalProperties": false
    },
